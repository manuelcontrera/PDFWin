<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PDFWin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PDFWin"
    xmlns:models="using:PDFWin.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PDFWin"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootContainer"
          Background="Transparent"
          AllowDrop="True"
          DragOver="RootContainer_DragOver"
          Drop="RootContainer_Drop">

        <!-- Outer floating card container filling window with native WinUI 3 rounded corners -->
        <Border x:Name="CardBorder"
                Margin="0"
                CornerRadius="0"
                BorderThickness="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" /> <!-- TitleBar / Header -->
                    <RowDefinition Height="*" />  <!-- Body / Content -->
                    <RowDefinition Height="Auto" /> <!-- Footer info / count -->
                </Grid.RowDefinitions>

                <!-- 1. Header Bar: Download on left, pill in center, Close on right -->
                <Grid Grid.Row="0"
                      x:Name="HeaderBar"
                      Background="Transparent"
                      PointerPressed="DragArea_PointerPressed"
                      PointerMoved="DragArea_PointerMoved"
                      PointerReleased="DragArea_PointerReleased"
                      PointerCaptureLost="DragArea_PointerCaptureLost">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>

                    <!-- Top Left: Download / Create PDF Button -->
                    <Button x:Name="BtnCreatePdf"
                            Grid.Column="0"
                            Width="34"
                            Height="34"
                            Margin="4,4,0,0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Crear PDF ahora"
                            Click="BtnCreatePdf_Click">
                        <FontIcon Glyph="&#xE896;" FontSize="15" />
                    </Button>

                    <!-- Top Center: Drag pill handle (matches image) -->
                    <Border Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="44"
                            Height="5"
                            CornerRadius="2.5"
                            Background="{ThemeResource TextFillColorTertiaryBrush}"
                            Opacity="0.8" />

                    <!-- Top Right: Close button 'X' -->
                    <Button x:Name="BtnClose"
                            Grid.Column="2"
                            Width="34"
                            Height="34"
                            Margin="0,4,4,0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="Cerrar ventana (Win+Alt+P para reabrir)"
                            Click="BtnClose_Click">
                        <FontIcon Glyph="&#xE8BB;" FontSize="12" />
                    </Button>
                </Grid>

                <!-- 2. Body: Empty State vs Populated State -->
                <Grid Grid.Row="1" Margin="8,0,8,4">

                    <!-- Empty State: "Drop items here" -->
                    <StackPanel x:Name="EmptyStatePanel"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Background="Transparent"
                                PointerPressed="DragArea_PointerPressed"
                                PointerMoved="DragArea_PointerMoved"
                                PointerReleased="DragArea_PointerReleased"
                                PointerCaptureLost="DragArea_PointerCaptureLost">
                        <TextBlock Text="Drop items here"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Populated State: Reorderable List of items -->
                    <Grid x:Name="PopulatedStatePanel" Visibility="Collapsed">
                        <ListView x:Name="ItemsListView"
                                  ItemsSource="{x:Bind DroppedItems}"
                                  CanReorderItems="True"
                                  CanDragItems="True"
                                  AllowDrop="True"
                                  SelectionMode="None"
                                  Padding="0,4,0,4">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="4,4,4,4" />
                                    <Setter Property="Margin" Value="0,2,0,2" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Padding="6">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /> <!-- Drag Grip -->
                                                <ColumnDefinition Width="42" />   <!-- Thumbnail -->
                                                <ColumnDefinition Width="*" />    <!-- Name & Size -->
                                                <ColumnDefinition Width="Auto" /> <!-- Remove button -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Drag grip dots -->
                                            <FontIcon Grid.Column="0"
                                                      Glyph="&#xE76F;"
                                                      FontSize="13"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      VerticalAlignment="Center" />

                                            <!-- Thumbnail or fallback icon -->
                                            <Border Grid.Column="1"
                                                    Width="38"
                                                    Height="38"
                                                    CornerRadius="5"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="UniformToFill"
                                                           Visibility="{Binding ThumbnailVisibility}" />
                                                    <FontIcon Glyph="{Binding TypeIconGlyph}"
                                                              FontSize="18"
                                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                              Visibility="{Binding IconFallbackVisibility}" />
                                                    <Border HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                                            CornerRadius="3"
                                                            Padding="3,0,3,0"
                                                            Margin="0,0,2,2"
                                                            Opacity="0.9">
                                                        <TextBlock Text="{Binding DisplayIndex}"
                                                                   FontSize="9"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Filename & Details -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{Binding FilePath}" />
                                                <TextBlock Text="{Binding FileSizeFormatted}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>

                                            <!-- Remove button -->
                                            <Button Grid.Column="3"
                                                    Width="28"
                                                    Height="28"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    ToolTipService.ToolTip="Quitar de la lista"
                                                    Click="BtnRemoveItem_Click"
                                                    Tag="{Binding}">
                                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Processing / Loading Overlay -->
                    <Grid x:Name="ProcessingOverlay"
                          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                          Opacity="0.92"
                          Visibility="Collapsed"
                          CornerRadius="12">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                            <ProgressRing IsActive="True" Width="36" Height="36" />
                            <TextBlock x:Name="TxtProcessingStatus"
                                       Text="Generando PDF..."
                                       FontSize="13"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 3. Bottom Pill / Status Badge matching "0 items ⌵" -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Button x:Name="BtnItemsBadge"
                            HorizontalAlignment="Center"
                            Height="32"
                            CornerRadius="8"
                            Padding="12,4,12,4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Click="BtnItemsBadge_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtItemCount"
                                       Text="0 items"
                                       FontSize="12"
                                       FontWeight="Medium" />
                            <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
