<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PDFWin</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <Version>1.5.0</Version>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <FileVersion>1.5.0.0</FileVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;publish\**;PDFWin_App\**;installer\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\StoreLogo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="PDFsharp" Version="6.1.1" />
  </ItemGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun>False</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <!-- Strip unused AI/ML/Search/Widgets/Debugger DLLs after Publish -->
  <Target Name="RemoveUnusedPublishBloat" AfterTargets="EnsurePriInPublish">
    <ItemGroup>
      <_UnusedPublishFiles Include="$(PublishDir)onnxruntime.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)DirectML.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)Microsoft.ML.OnnxRuntime.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)Microsoft.Asg.SemanticIndex.*.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)Microsoft.Windows.AI.*.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)Microsoft.Windows.AI.*.winmd" />
      <_UnusedPublishFiles Include="$(PublishDir)Microsoft.Windows.Search*.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)Microsoft.Windows.Search*.winmd" />
      <_UnusedPublishFiles Include="$(PublishDir)Microsoft.Windows.Widgets*.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)Microsoft.Windows.Widgets*.winmd" />
      <_UnusedPublishFiles Include="$(PublishDir)Microsoft.Windows.Workloads*.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)PerceptiveStreaming.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)NPUDetect.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)Microsoft.DiaSymReader.Native.*.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)mscordaccore*.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)mscordbi.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)createdump.exe" />
      <_UnusedPublishFiles Include="$(PublishDir)RestartAgent.exe" />
      <_UnusedPublishFiles Include="$(PublishDir)PdfSharp.Charting.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)PdfSharp.Snippets.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)PdfSharp.WPFonts.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)PdfSharp.Quality.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)Microsoft.Windows.Workloads.pri" />
      <_UnusedPublishFiles Include="$(PublishDir)workloads*.json" />
      <_UnusedPublishFiles Include="$(PublishDir)*.winmd" />
      <_UnusedPublishFiles Include="$(PublishDir)DwmSceneI.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)Microsoft.UI.Xaml.Phone.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)Microsoft.Web.WebView2.Core.Projection.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)System.Reflection.Metadata.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)System.Collections.Immutable.dll" />
      <_UnusedPublishFiles Include="$(PublishDir)$(TargetName).pri" Condition="Exists('$(PublishDir)resources.pri')" />
    </ItemGroup>
    <Delete Files="@(_UnusedPublishFiles)" TreatErrorsAsWarnings="true" />
  </Target>

  <!-- Guarantee PRI files are generated as resources.pri and always present in TargetDir & PublishDir -->
  <Target Name="EnsurePriInPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)resources.pri" DestinationFiles="$(PublishDir)resources.pri" Condition="Exists('$(TargetDir)resources.pri')" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pri" DestinationFiles="$(PublishDir)resources.pri" Condition="Exists('$(TargetDir)$(TargetName).pri') and !Exists('$(TargetDir)resources.pri')" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pri" DestinationFolder="$(PublishDir)" Condition="Exists('$(TargetDir)$(TargetName).pri')" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TargetDir)resources.pri" DestinationFiles="$(PublishDir)$(TargetName).pri" Condition="Exists('$(TargetDir)resources.pri') and !Exists('$(TargetDir)$(TargetName).pri')" SkipUnchangedFiles="false" />
  </Target>

  <Target Name="EnsurePriInTarget" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)$(TargetName).pri" DestinationFiles="$(TargetDir)resources.pri" Condition="Exists('$(TargetDir)$(TargetName).pri') and !Exists('$(TargetDir)resources.pri')" SkipUnchangedFiles="false" />
    <Copy SourceFiles="$(TargetDir)resources.pri" DestinationFiles="$(TargetDir)$(TargetName).pri" Condition="Exists('$(TargetDir)resources.pri') and !Exists('$(TargetDir)$(TargetName).pri')" SkipUnchangedFiles="false" />
  </Target>
</Project>