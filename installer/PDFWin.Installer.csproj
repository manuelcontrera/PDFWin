<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>PDFWin.Installer</RootNamespace>
    <ApplicationIcon>..\Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>installer.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PDFWin-Setup</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.tar.xz" LogicalName="PDFWin.Installer.app.tar.xz" Condition="Exists('app.tar.xz')" />
    <EmbeddedResource Include="Uninstall.bin" LogicalName="PDFWin.Installer.Uninstall.bin" Condition="Exists('Uninstall.bin')" />
  </ItemGroup>
</Project>
